# ─── Target API ────────────────────────────────────────────────────────────────
# URL base da API voting-session (sem trailing slash)
#
# PORTA PADRÃO DO DOCKER-COMPOSE: 8081
#   O docker-compose.yml da voting-session mapeia 8081:8080 para evitar conflito.
#   Se rodando via docker-compose:  BASE_URL=http://localhost:8081
#   Se rodando o JAR diretamente:   BASE_URL=http://localhost:8080
#   Se k6 estiver dentro do Docker: BASE_URL=http://host.docker.internal:8081
#
BASE_URL=http://localhost:8081

# ─── Observabilidade ────────────────────────────────────────────────────────────
# InfluxDB — coleta métricas em tempo real durante os testes
INFLUXDB_URL=http://localhost:8086
INFLUXDB_DB=k6

# Grafana — dashboard de visualização
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ─── Validação de CPF na API ────────────────────────────────────────────────────
# A voting-session valida CPFs via serviço externo (user-info.herokuapp.com).
# Os CPFs gerados pelo k6 são matematicamente válidos (passam no algoritmo
# de dígitos verificadores da Receita Federal), mas se o serviço externo
# ainda bloquear os votos com 403, desabilite a validação no docker-compose
# da voting-session adicionando a variável de ambiente abaixo:
#
#   No docker-compose.yml da voting-session, em services.app.environment:
#     CPF_VALIDATION_ENABLED: "false"
#
#   Ou ao subir o container manualmente:
#     docker run -e CPF_VALIDATION_ENABLED=false ... voting-session
#
# ─── Configurações de Teste ─────────────────────────────────────────────────────
# Número base de VUs para carga normal
LOAD_VUS=50

# Duração do soak test (padrão: 30m para dev, aumentar para produção)
SOAK_DURATION=30m

# Volume de dados para o volume test
VOLUME_AGENDAS=500
VOLUME_VOTES_PER_AGENDA=100
