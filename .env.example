# ══════════════════════════════════════════════════════════════════════════════
# voting-session-k6 — Variáveis de Configuração
#
# Copie este arquivo para .env e ajuste os valores antes de rodar os testes:
#   cp .env.example .env
#
# Todas as variáveis podem ser passadas diretamente na linha de comando:
#   LOAD_VUS=100 LOAD_STEADY=10m ./run/run-test.sh load
#   SPIKE_PEAK_VUS=1000 ./run/run-test.sh spike
# ══════════════════════════════════════════════════════════════════════════════

# ─── Target API ────────────────────────────────────────────────────────────────
# URL base da API voting-session (sem trailing slash)
#
# PORTA PADRÃO DO DOCKER-COMPOSE: 8081
#   O docker-compose.yml da voting-session mapeia 8081:8080 para evitar conflito.
#   Se rodando via docker-compose:  BASE_URL=http://localhost:8081
#   Se rodando o JAR diretamente:   BASE_URL=http://localhost:8080
#   Se k6 estiver dentro do Docker: BASE_URL=http://host.docker.internal:8081
#
BASE_URL=http://localhost:8081

# ─── Validação de CPF ──────────────────────────────────────────────────────────
# OBRIGATÓRIO para testes de performance: desabilitar no docker-compose da voting-session
#   services.app.environment.CPF_VALIDATION_ENABLED: "false"
# O serviço user-info.herokuapp.com faz lookup por banco de dados — CPFs
# sintéticos do k6 retornarão 403 mesmo sendo matematicamente válidos.

# ─── Observabilidade ────────────────────────────────────────────────────────────
INFLUXDB_URL=http://localhost:8086
INFLUXDB_DB=k6
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Habilitar envio de métricas ao InfluxDB durante os testes
K6_INFLUXDB_OUT=false

# ══════════════════════════════════════════════════════════════════════════════
# PARÂMETROS DE TESTE — ajustar conforme o ambiente e objetivo
# ══════════════════════════════════════════════════════════════════════════════

# ─── Timeout HTTP das requisições k6 ─────────────────────────────────────────
# Evita que timeouts TCP (30s padrão do kernel) travem VUs e inflem métricas.
# Ajuste para mais em staging/prod se a latência real for alta.
K6_TIMEOUT=10s

# ─── Teste de Carga (01-load-test.js) ─────────────────────────────────────────
# Simula o volume de usuários diário esperado
#
# DICA: Para Docker local com recursos limitados, prefira LOAD_VUS entre 10-20.
# Para staging com app dedicada, use 50-200.
LOAD_VUS=20            # VUs no estado estacionário
LOAD_RAMPUP=30s        # Duração do ramp-up gradual
LOAD_STEADY=3m         # Duração da carga estável (estado estacionário)
LOAD_RAMPDOWN=30s      # Duração do ramp-down gradual

# ─── Teste de Estresse (02-stress-test.js) ────────────────────────────────────
# Escalas crescentes até o ponto de quebra
# Estágios: LOAD_VUS → 2x → 3x → 4x → STRESS_MAX_VUS → recuperação
STRESS_MAX_VUS=300            # VUs máximos no pico de estresse
STRESS_STAGE_DURATION=2m      # Duração de cada estágio da escada
STRESS_RECOVERY_VUS=50        # VUs no estágio de recuperação (padrão = LOAD_VUS)

# ─── Teste de Pico (03-spike-test.js) ─────────────────────────────────────────
# Choque instantâneo de SPIKE_BASE_VUS para SPIKE_PEAK_VUS
SPIKE_BASE_VUS=10             # VUs em tráfego normal (pré e pós-pico)
SPIKE_PEAK_VUS=500            # VUs no pico instantâneo (ex: 50x o normal)
SPIKE_WARMUP_DURATION=1m      # Aquecimento antes do pico
SPIKE_PEAK_DURATION=2m        # Duração do pico
SPIKE_RECOVERY_DURATION=3m    # Tempo de observação da recuperação

# ─── Teste de Imersão / Soak (04-soak-test.js) ────────────────────────────────
# Carga constante por longo período — detecta memory leaks e degradação
# LOAD_VUS é reutilizado como número de VUs constantes
SOAK_DURATION=30m      # Duração da fase de imersão (produção: 2h ou mais)
SOAK_RAMPUP=2m         # Ramp-up suave antes do soak
SOAK_RAMPDOWN=1m       # Ramp-down ao final

# ─── Teste de Volume (05-volume-test.js) ──────────────────────────────────────
# Inserção massiva de dados para testar índices e degradação por volume
VOLUME_AGENDAS=500            # Total de pautas a criar (bulk insert)
VOLUME_VOTES_PER_AGENDA=20    # Votos por pauta (total = AGENDAS × VOTES)
VOLUME_INSERT_VUS=10          # VUs na fase de inserção em volume
VOLUME_WARMUP_VUS=5           # VUs no warmup inicial (10% das agendas)
VOLUME_QUERY_VUS=20           # VUs na fase de query stress (banco cheio)
VOLUME_QUERY_DURATION=5m      # Duração da fase de queries com banco populado
